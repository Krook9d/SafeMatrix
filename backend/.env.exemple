DATABASE_URL=postgresql://user:password@localhost:5432/main_db
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
SECRET_KEY=dev-secret-key
NVD_TOKEN_API=ToBeChange

# Gmail Configuration for Email Notifications
# Replace with your Gmail address
GMAIL_USERNAME=your-email@gmail.com

# Gmail App Password (16 characters)
# Generate from https://myaccount.google.com/security
GMAIL_APP_PASSWORD=your-app-password-here

# Display name in emails
GMAIL_FROM_NAME=SafeMatrix Security

# Redis Configuration for Workflow Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
